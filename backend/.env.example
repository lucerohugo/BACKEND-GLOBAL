# Copiar como .env para desarrollo local.
# En producción los scripts de deploy/ generan un .env por cliente automáticamente.

SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True

# Hosts permitidos separados por coma (en producción: el dominio o la IP del VPS)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origen del frontend que consume la API. Vacío = se permite cualquiera
CORS_ALLOWED_ORIGINS=

# Solo con dominio + HTTPS. Ej: https://api.cliente.com.ar
CSRF_TRUSTED_ORIGINS=
BEHIND_HTTPS_PROXY=False

# Carpeta de datos (db.sqlite3, media/, backups/). Vacío = carpeta backend/
# DATA_DIR=

# Clave que deben enviar el dashboard y la sincronización:
#   Authorization: Bearer <API_SYNC_KEY>     (o header X-API-Key)
# Sin clave solo se puede ver la API logueado en /admin/
API_SYNC_KEY=

# Transición: True deja la API abierta sin clave como antes (NO usar en producción)
API_PUBLICA=False
